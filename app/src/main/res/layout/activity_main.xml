<?xml version="1.0" encoding="utf-8"?>
<!--
    模块主界面:仅保留激活信息、好友圈设置入口、检查更新、查看公告、应用信息。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:background="@color/md_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/watch_screen_padding">

        <!-- 顶部:模块标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/md_on_surface" />

        <!-- 激活状态摘要(点击展开/折叠详情) -->
        <LinearLayout
            android:id="@+id/statusHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvStatusSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/status_checking"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_on_surface" />

            <TextView
                android:id="@+id/tvExpandIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="▾"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_on_surface_variant" />
        </LinearLayout>

        <!-- 激活详情(默认折叠) -->
        <LinearLayout
            android:id="@+id/detailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/statusDot"
                android:layout_width="@dimen/status_dot"
                android:layout_height="@dimen/status_dot"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/dot_checking" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/status_checking"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:id="@+id/tvLastActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/never_active"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:id="@+id/tvTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/module_target"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/watch_square_hint"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_tertiary" />

            <TextView
                android:id="@+id/tvRootStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/root_status_checking"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_on_surface_variant" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@color/md_outline_variant" />

        <!-- 好友圈设置入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFriendCircleSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:text="好友圈设置"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 运动设置入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSportSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/sport_settings_title"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 适配应用下载入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApps"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/app_center_title"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 字体中心入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontCenter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/font_center_title"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 模块字体设置入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModuleFont"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/module_font_title"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 查看公告 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/btn_announcement"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 检测更新 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckUpdate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/btn_check_update"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@color/md_outline_variant" />

        <!-- 应用信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="应用信息"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/md_on_surface" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_on_surface_variant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="by 老李不会飞\n交流q群746269236"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_on_surface_variant" />

        <!-- 开源链接 -->
        <TextView
            android:id="@+id/tvGithubLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="本模块以GPL 3.0开源"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_expressive_blue" />

    </LinearLayout>
</ScrollView>
