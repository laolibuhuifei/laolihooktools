<?xml version="1.0" encoding="utf-8"?>
<!--
    方形手表屏幕(1:1)适配布局。
    - 每行只放一个控件,适配小屏。
    - 滚动容器。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:background="@color/md_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/watch_screen_padding">

        <!-- 顶部:模块标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/md_on_surface" />

        <!-- 激活状态摘要(点击展开/折叠详情) -->
        <LinearLayout
            android:id="@+id/statusHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvStatusSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/status_checking"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_on_surface" />

            <TextView
                android:id="@+id/tvExpandIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="▾"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_on_surface_variant" />
        </LinearLayout>

        <!-- 激活详情(默认折叠) -->
        <LinearLayout
            android:id="@+id/detailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/statusDot"
                android:layout_width="@dimen/status_dot"
                android:layout_height="@dimen/status_dot"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/dot_checking" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/status_checking"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:id="@+id/tvLastActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/never_active"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:id="@+id/tvTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/module_target"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/watch_square_hint"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_tertiary" />

            <TextView
                android:id="@+id/tvRootStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/root_status_checking"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_on_surface_variant" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@color/md_outline_variant" />

        <!-- 资源替换卡:好友圈背景 -->
        <include
            android:id="@+id/cardHeadBg"
            layout="@layout/item_resource_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 资源替换卡:消息背景 -->
        <include
            android:id="@+id/cardMsgBg"
            layout="@layout/item_resource_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />

        <!-- 文字替换卡:好友圈标题文字 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_moment_scene"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_moment_scene_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchString"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />

                <TextView
                    android:id="@+id/tvStringState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/string_not_set"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:hint="@string/string_value_hint"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStringValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveString"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/save"
                    app:cornerRadius="@dimen/card_radius_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 时间详细显示 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_time_detail"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_time_detail_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchTimeDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 防删除 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_anti_delete"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_anti_delete_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAntiDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 链接自动跳转 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_link_jump"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_link_jump_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLinkJump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 还原所有编辑的动态 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/restore_all_edit"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/restore_all_edit_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestoreEdit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="还原"
                    app:cornerRadius="@dimen/card_radius_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 颜色修改入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColorSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/feature_theme_color"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 查看公告 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/btn_announcement"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 检测更新 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckUpdate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/btn_check_update"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 查看日志按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewLog"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="查看日志"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 底部操作区 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/restart_target"
            app:cornerRadius="@dimen/card_radius_small" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/restart_target_desc"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_on_surface_variant" />

        <!-- 底部署名 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="by 老李不会飞\n交流q群746269236"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_on_surface_variant" />

        <!-- 开源链接 -->
        <TextView
            android:id="@+id/tvGithubLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="本模块以GPL 3.0开源"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_expressive_blue" />

    </LinearLayout>
</ScrollView>
