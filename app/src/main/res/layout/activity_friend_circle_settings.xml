<?xml version="1.0" encoding="utf-8"?>
<!--
    好友圈设置页:集中所有好友圈相关功能(资源替换/文字替换/开关/收藏/颜色/还原/重启等)。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:background="@color/md_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/watch_screen_padding">

        <!-- 顶栏:返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_sm"
                android:text="@string/back"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="好友圈设置"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/md_on_surface" />
        </LinearLayout>

        <!-- 资源替换卡:好友圈背景 -->
        <include
            android:id="@+id/cardHeadBg"
            layout="@layout/item_resource_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />

        <!-- 资源替换卡:消息背景 -->
        <include
            android:id="@+id/cardMsgBg"
            layout="@layout/item_resource_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />

        <!-- 文字替换卡:好友圈标题文字 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_moment_scene"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_moment_scene_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchString"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />

                <TextView
                    android:id="@+id/tvStringState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/string_not_set"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:hint="@string/string_value_hint"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStringValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveString"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/save"
                    app:cornerRadius="@dimen/card_radius_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 时间详细显示 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_time_detail"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_time_detail_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchTimeDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 防删除 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_anti_delete"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_anti_delete_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAntiDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 链接自动跳转 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_link_jump"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_link_jump_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLinkJump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 自定义字体 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/feature_font"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/feature_font_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFont"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_sm" />

                <TextView
                    android:id="@+id/tvFontState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/font_not_set"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectFont"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/select_font"
                    app:cornerRadius="@dimen/card_radius_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectDownloadedFont"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/font_select_downloaded"
                    app:cornerRadius="@dimen/card_radius_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearFont"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/clear_image"
                    app:cornerRadius="@dimen/card_radius_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 主题色入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColorSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/feature_theme_color"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 收藏夹入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavorites"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="收藏夹"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 还原所有编辑的动态 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/md_surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/restore_all_edit"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/restore_all_edit_desc"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestoreEdit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="还原"
                    app:cornerRadius="@dimen/card_radius_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 查看日志 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewLog"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="查看日志"
            app:cornerRadius="@dimen/card_radius_small" />

        <!-- 重启好友圈 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/restart_target"
            app:cornerRadius="@dimen/card_radius_small" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/restart_target_desc"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_on_surface_variant" />

    </LinearLayout>
</ScrollView>
